VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_VAPID_PUBLIC_KEY=...

# Opcional. 1 = la INTERFAZ ofrece precio fijo, diagnóstico y cotización. No basta: el servidor también debe
# activarlas (update app_config set propuestas_activas = true). Ver docs/experiencia-cliente.md.
VITE_PROPUESTAS_ACTIVAS=

# Solo para vistas previas de pruebas: 'si' muestra el aviso "ENTORNO DE PRUEBAS". Nunca en producción.
VITE_ENTORNO_PRUEBAS=
